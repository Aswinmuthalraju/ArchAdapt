# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Gemini (server only; never exposed to the browser) ----
# Up to three keys. They are tried in this order; when one is rate limited, revoked or unreachable the next is used.
GENAI_API_KEY=your-first-gemini-key
GENAI_API_KEY_2=your-second-gemini-key
GENAI_API_KEY_3=your-third-gemini-key
# Optional alternative: one comma-separated list instead of the three variables above.
# GENAI_API_KEYS=key-a,key-b,key-c

# Optional: comma-separated Gemini models, tried in order (default: gemini-2.5-flash,gemini-2.5-pro)
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Optional: set to true to disable the automatic hand-over to the built-in rule engine when Gemini fails
# ARCHADAPT_STRICT_AI=false
